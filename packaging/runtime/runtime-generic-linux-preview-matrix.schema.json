{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/guojin-yan/OpenCV-CSharp-API/blob/opencv5.x/packaging/runtime/runtime-generic-linux-preview-matrix.schema.json",
  "title": "Generic linux-x64 preview producer and consumer matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "status",
    "targetRid",
    "activePackageIdentityAllowed",
    "previewArtifactIdentityAllowed",
    "publicationAllowed",
    "activePackageMatrix",
    "feasibilityContract",
    "producer",
    "consumers",
    "rids",
    "profiles"
  ],
  "properties": {
    "$schema": { "const": "runtime-generic-linux-preview-matrix.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "preview-only" },
    "targetRid": { "const": "linux-x64" },
    "activePackageIdentityAllowed": { "const": false },
    "previewArtifactIdentityAllowed": { "const": true },
    "publicationAllowed": { "const": false },
    "activePackageMatrix": { "const": "packaging/runtime/runtime-package-matrix.json" },
    "feasibilityContract": { "const": "packaging/runtime/runtime-generic-linux-feasibility.json" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "rid", "sourceRid", "distro", "distroVersion", "runner", "profiles", "glibcBaseline", "artifactPrefix" ],
      "properties": {
        "rid": { "const": "linux-x64" },
        "sourceRid": { "const": "ubuntu.22.04-x64" },
        "distro": { "const": "ubuntu" },
        "distroVersion": { "const": "22.04" },
        "runner": { "const": "ubuntu-22.04" },
        "profiles": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": [ "full", "mini" ] }
        },
        "glibcBaseline": { "const": "2.35" },
        "artifactPrefix": { "const": "generic-linux-preview-runtime-input" }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "rid", "distro", "distroVersion", "runner", "role", "execution", "profiles" ],
        "properties": {
          "rid": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+-x64$" },
          "distro": { "type": "string", "minLength": 1 },
          "distroVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "runner": { "type": "string", "minLength": 1 },
          "role": { "enum": [ "baseline", "cross-distro" ] },
          "execution": { "enum": [ "hosted-runner", "container" ] },
          "containerImage": { "type": "string", "pattern": "^[a-z0-9./:_-]+@sha256:[0-9a-f]{64}$" },
          "profiles": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "enum": [ "full", "mini" ] }
          }
        }
      }
    },
    "rids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "rid", "platformFamily", "opencvRid", "nativeExtension", "producer" ],
        "properties": {
          "rid": { "const": "linux-x64" },
          "platformFamily": { "const": "linux" },
          "opencvRid": { "const": "ubuntu.22.04-x64" },
          "nativeExtension": { "const": ".so" },
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "kind", "profiles" ],
            "properties": {
              "kind": { "const": "linux" },
              "profiles": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": { "enum": [ "full", "mini" ] }
              }
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "name", "packageIdSuffix", "buildList", "modules", "optionalModules", "packageId", "artifactName" ],
        "properties": {
          "name": { "enum": [ "full", "mini" ] },
          "packageIdSuffix": { "type": "string" },
          "buildList": { "type": "string", "minLength": 1 },
          "modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "optionalModules": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "packageId": { "type": "string", "pattern": "^JYPPX\\.OpenCV\\.runtime\\.linux-x64\\.preview(?:\\.mini)?$" },
          "artifactName": { "type": "string", "pattern": "^nupkg-linux-x64-preview-(?:full|mini)$" }
        }
      }
    }
  }
}
