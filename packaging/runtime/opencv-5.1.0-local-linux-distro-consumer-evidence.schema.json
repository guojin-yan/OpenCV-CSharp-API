{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local OpenCV 5.1 Ubuntu/Debian/Fedora preview consumers",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "status",
    "openCvVersion",
    "packageVersion",
    "sourceBaseCommit",
    "worktreeChangesIncluded",
    "execution",
    "hosted",
    "publicationAllowed",
    "genericStablePromoted",
    "dockerHost",
    "baselineEvidence",
    "matrix",
    "baseGraphJson",
    "baseGraphSha256",
    "sourceInputs",
    "kitManifest",
    "toolchain",
    "consumers",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceKind": {
      "const": "local-linux-5.1-three-distro-preview-consumers"
    },
    "status": {
      "const": "verified-local-three-distro-x64-preview"
    },
    "openCvVersion": {
      "const": "5.1.0"
    },
    "packageVersion": {
      "const": "5.1.0"
    },
    "sourceBaseCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "worktreeChangesIncluded": {
      "const": true
    },
    "execution": {
      "const": "local-docker"
    },
    "hosted": {
      "const": false
    },
    "publicationAllowed": {
      "const": false
    },
    "genericStablePromoted": {
      "const": false
    },
    "dockerHost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture",
        "platform",
        "serverVersion"
      ],
      "properties": {
        "architecture": {
          "const": "x86_64"
        },
        "platform": {
          "const": "linux"
        },
        "serverVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "baselineEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "packaging/runtime/opencv-5.1.0-local-linux-preview-evidence.json"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "packaging/runtime/runtime-generic-linux-5.1-local-consumer-matrix.json"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "baseGraphJson": {
      "type": "string",
      "minLength": 100
    },
    "baseGraphSha256": {
      "$ref": "#/$defs/hash"
    },
    "sourceInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      },
      "minItems": 12,
      "maxItems": 12
    },
    "kitManifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        }
      },
      "minItems": 14,
      "maxItems": 14
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "powerShellArchiveSha256",
        "dotNetArchiveSha512",
        "bootstrapCaSha256"
      ],
      "properties": {
        "powerShellArchiveSha256": {
          "$ref": "#/$defs/hash"
        },
        "dotNetArchiveSha512": {
          "type": "string",
          "pattern": "^[a-f0-9]{128}$"
        },
        "bootstrapCaSha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rid",
          "identity",
          "outputDirectory",
          "bootstrapOutput",
          "bootstrapOutputSha256",
          "driverOutput",
          "driverOutputSha256",
          "preflightJson",
          "preflightSha256",
          "packages",
          "profiles"
        ],
        "properties": {
          "rid": {
            "enum": [
              "debian.12-x64",
              "fedora.44-x64"
            ]
          },
          "identity": {
            "$ref": "#/$defs/container"
          },
          "outputDirectory": {
            "type": "string",
            "minLength": 1
          },
          "bootstrapOutput": {
            "type": "string",
            "minLength": 100
          },
          "bootstrapOutputSha256": {
            "$ref": "#/$defs/hash"
          },
          "driverOutput": {
            "type": "string",
            "minLength": 100
          },
          "driverOutputSha256": {
            "$ref": "#/$defs/hash"
          },
          "preflightJson": {
            "type": "string",
            "minLength": 100
          },
          "preflightSha256": {
            "$ref": "#/$defs/hash"
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "artifactPath",
                "bytes",
                "sha256"
              ],
              "properties": {
                "artifactPath": {
                  "type": "string",
                  "minLength": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "$ref": "#/$defs/hash"
                }
              }
            },
            "minItems": 3,
            "maxItems": 3
          },
          "profiles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "consumerEvidenceJson",
                "consumerEvidenceSha256",
                "consumerOutput",
                "consumerOutputSha256"
              ],
              "properties": {
                "name": {
                  "enum": [
                    "full",
                    "mini"
                  ]
                },
                "consumerEvidenceJson": {
                  "type": "string",
                  "minLength": 100
                },
                "consumerEvidenceSha256": {
                  "$ref": "#/$defs/hash"
                },
                "consumerOutput": {
                  "type": "string",
                  "minLength": 100
                },
                "consumerOutputSha256": {
                  "$ref": "#/$defs/hash"
                }
              }
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "minItems": 2,
      "maxItems": 2
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumerRids",
        "profiles",
        "totalProfilePairs",
        "baselineProfilePairs",
        "newProfilePairs",
        "localThreeDistroConsumerGateComplete",
        "baselineProducerSourceCommit",
        "baselineUbuntuEvidenceReused",
        "newProducerBuildExecuted",
        "arm64Validated",
        "hostedValidated",
        "dnnModelInferenceValidated",
        "videoFileOrDeviceValidated",
        "finalReleaseApproved"
      ],
      "properties": {
        "consumerRids": {
          "const": [
            "ubuntu.22.04-x64",
            "debian.12-x64",
            "fedora.44-x64"
          ]
        },
        "profiles": {
          "const": [
            "full",
            "mini"
          ]
        },
        "totalProfilePairs": {
          "const": 6
        },
        "baselineProfilePairs": {
          "const": 2
        },
        "newProfilePairs": {
          "const": 4
        },
        "localThreeDistroConsumerGateComplete": {
          "const": true
        },
        "baselineProducerSourceCommit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "baselineUbuntuEvidenceReused": {
          "const": true
        },
        "newProducerBuildExecuted": {
          "const": false
        },
        "arm64Validated": {
          "const": false
        },
        "hostedValidated": {
          "const": false
        },
        "dnnModelInferenceValidated": {
          "const": false
        },
        "videoFileOrDeviceValidated": {
          "const": false
        },
        "finalReleaseApproved": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "image",
        "imageId",
        "platform",
        "nanoCpus",
        "memoryBytes",
        "mounts",
        "imageArchitecture",
        "imageOs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/hash"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "pattern": "^(debian:12|fedora:44)@sha256:[a-f0-9]{64}$"
        },
        "imageId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "platform": {
          "const": "linux"
        },
        "nanoCpus": {
          "type": "integer",
          "minimum": 1
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1
        },
        "mounts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "source",
              "destination",
              "writable"
            ],
            "properties": {
              "type": {
                "enum": [
                  "bind",
                  "volume"
                ]
              },
              "source": {
                "type": "string"
              },
              "destination": {
                "type": "string"
              },
              "writable": {
                "type": "boolean"
              }
            }
          },
          "maxItems": 2
        },
        "imageArchitecture": {
          "const": "amd64"
        },
        "imageOs": {
          "const": "linux"
        }
      }
    }
  }
}
