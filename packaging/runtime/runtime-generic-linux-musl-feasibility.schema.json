{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/OpenCV-CSharp-API/runtime-generic-linux-musl-feasibility.schema.json",
  "title": "Generic linux-musl feasibility contract",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "status", "packageIdentityAllowed", "activePackageMatrix", "targetRids", "ridSelection", "referenceTargets", "dependencyPolicy", "requiredEvidence", "promotionGates", "stopConditions", "rollback" ],
  "properties": {
    "$schema": { "const": "runtime-generic-linux-musl-feasibility.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "research-only" },
    "packageIdentityAllowed": { "const": false },
    "activePackageMatrix": { "const": "packaging/runtime/runtime-package-matrix.json" },
    "targetRids": { "const": [ "linux-musl-x64", "linux-musl-arm64" ] },
    "ridSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "x64Graph", "arm64Graph", "exactAssetPriority", "glibcFallback", "packageReferencePolicy" ],
      "properties": {
        "x64Graph": { "const": "linux-musl-x64 imports linux-musl; linux-musl imports linux" },
        "arm64Graph": { "type": "string", "pattern": "native AArch64" },
        "exactAssetPriority": { "type": "string", "pattern": "exact musl RID assets" },
        "glibcFallback": { "type": "string", "pattern": "rejected" },
        "packageReferencePolicy": { "type": "string", "minLength": 20 }
      }
    },
    "referenceTargets": {
      "type": "array",
      "const": [
        { "rid": "alpine.3.20-x64", "distro": "alpine", "distroVersion": "3.20", "architecture": "x64", "role": "compatibility-reference", "execution": "container-on-native-x64", "status": "compatibility-only" },
        { "rid": "alpine.3.20-arm64", "distro": "alpine", "distroVersion": "3.20", "architecture": "arm64", "role": "research-reference", "execution": "native-aarch64-required", "status": "research-only" }
      ]
    },
    "dependencyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "libc", "allowedClasses", "forbiddenClasses", "backendPolicy", "guiPolicy" ],
      "properties": {
        "libc": { "const": "musl-only; no glibc loader or glibc-only symbol may enter a candidate payload" },
        "allowedClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "forbiddenClasses": { "const": [ "glibc", "unreviewed-gui-backend", "unbounded-camera-backend" ] },
        "backendPolicy": { "type": "string", "minLength": 30 },
        "guiPolicy": { "type": "string", "minLength": 20 }
      }
    },
    "requiredEvidence": { "type": "array", "const": [ "native x64 producer and independent consumer with digest-pinned Alpine userspace", "native AArch64 producer and consumer or an explicit research-only stop decision", "Full and Mini profile parity with distinct ABI manifests", "musl interpreter, symbol, dependency, and producer-to-package hash closure", "codec, DNN, and explicit VideoIO backend smoke with timeout and cleanup", "RID exact-asset precedence and glibc-candidate rejection tests" ] },
    "promotionGates": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string", "minLength": 20 } },
    "stopConditions": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string", "minLength": 15 } },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "onFailure", "activeIdentity", "fallbackPrecedenceChanged", "noImplicitPromotion" ],
      "properties": {
        "onFailure": { "type": "string", "minLength": 30 },
        "activeIdentity": { "const": "packaging/runtime/runtime-package-matrix.json" },
        "fallbackPrecedenceChanged": { "const": false },
        "noImplicitPromotion": { "const": true }
      }
    }
  }
}
