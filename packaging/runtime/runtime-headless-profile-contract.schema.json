{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/OpenCV-CSharp-API/runtime-headless-profile-contract.schema.json",
  "title": "Headless runtime profile candidate contract",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "status", "packageIdentityAllowed", "candidatePackageSuffix", "runtimePackagePrefix", "activePackageMatrix", "baseProfile", "omittedModules", "requiredModules", "profiles", "targetRids", "dependencyPolicy", "abiPolicy", "negativeSmoke", "promotionGates", "rollback" ],
  "properties": {
    "$schema": { "const": "runtime-headless-profile-contract.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "candidate-only" },
    "packageIdentityAllowed": { "const": false },
    "candidatePackageSuffix": { "const": ".headless" },
    "runtimePackagePrefix": { "const": "JYPPX.OpenCV.runtime" },
    "activePackageMatrix": { "const": "packaging/runtime/runtime-package-matrix.json" },
    "baseProfile": { "const": "full" },
    "omittedModules": { "type": "array", "const": [ "highgui" ] },
    "requiredModules": {
      "type": "array",
      "minItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    },
    "profiles": { "type": "array", "const": [ "full", "mini" ] },
    "targetRids": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "rid", "distro", "distroVersion", "role", "execution" ],
        "properties": {
          "rid": { "enum": [ "ubuntu.22.04-x64", "ubuntu.24.04-x64", "debian.12-x64" ] },
          "distro": { "enum": [ "ubuntu", "debian" ] },
          "distroVersion": { "enum": [ "22.04", "24.04", "12" ] },
          "role": { "enum": [ "baseline", "forward-distro", "cross-distro" ] },
          "execution": { "enum": [ "native-x64", "container-on-native-x64" ] }
        }
      }
    },
    "dependencyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "allowedClasses", "forbiddenSonamePatterns", "forbiddenEnvironmentVariables", "forbiddenRuntimeRoots", "backendPolicy" ],
      "properties": {
        "allowedClasses": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "forbiddenSonamePatterns": { "const": [ "libgtk*", "libgdk*", "libQt*", "libX11*", "libXext*", "libwayland*" ] },
        "forbiddenEnvironmentVariables": { "const": [ "DISPLAY", "WAYLAND_DISPLAY" ] },
        "forbiddenRuntimeRoots": { "const": [ "LD_LIBRARY_PATH", "OPENCV_CSHARP_OPENCV_RUNTIME_ROOT" ] },
        "backendPolicy": { "type": "string", "minLength": 20 }
      }
    },
    "abiPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "managedApiChange", "newNativeEntrypoints", "loaderCount", "manifestPolicy", "highguiBehavior" ],
      "properties": {
        "managedApiChange": { "const": false },
        "newNativeEntrypoints": { "const": false },
        "loaderCount": { "const": 1 },
        "manifestPolicy": { "type": "string", "minLength": 20 },
        "highguiBehavior": { "type": "string", "pattern": "(?i)NOT_LINKED" }
      }
    },
    "negativeSmoke": { "type": "array", "minItems": 7, "uniqueItems": true, "items": { "type": "string", "minLength": 20 } },
    "promotionGates": { "type": "array", "minItems": 6, "uniqueItems": true, "items": { "type": "string", "minLength": 20 } },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "onFailure", "activeIdentity", "fallbackPrecedenceChanged", "noImplicitPromotion" ],
      "properties": {
        "onFailure": { "type": "string", "minLength": 30 },
        "activeIdentity": { "const": "packaging/runtime/runtime-package-matrix.json" },
        "fallbackPrecedenceChanged": { "const": false },
        "noImplicitPromotion": { "const": true }
      }
    }
  }
}
