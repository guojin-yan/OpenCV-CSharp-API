{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/OpenCV-CSharp-API/blob/opencv5.x/packaging/runtime/runtime-headless-candidate-evidence.schema.json",
  "title": "Headless runtime candidate negative smoke evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "status", "sourceCommit", "candidateProfile", "candidatePackageIdentityAllowed", "runner", "timeoutSeconds", "runtimePackage", "environment", "frameworks", "videoio", "verifiedCases", "limitations" ],
  "properties": {
    "$schema": { "const": "runtime-headless-candidate-evidence.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "candidate-partial" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateProfile": { "const": "mini-headless-candidate" },
    "candidatePackageIdentityAllowed": { "const": false },
    "timeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 600 },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "os", "architecture", "dotnet", "configuration" ],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "const": "x64" },
        "dotnet": { "type": "string", "pattern": "^10\\.0\\.\\d+$" },
        "configuration": { "const": "Release" }
      }
    },
    "runtimePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "packageFileName", "packageSha256", "nativeDllCount", "payload" ],
      "properties": {
        "packageFileName": { "const": "jyppx.opencv.runtime.win-x64.mini.5.0.0.nupkg" },
        "packageSha256": { "const": "c4712ed62f34f31eacaaa4c51f84ee6003bf5bab3cfcca850d39c3b812628918" },
        "nativeDllCount": { "const": 7 },
        "payload": { "type": "array", "minItems": 7, "maxItems": 7 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "displayUnset", "waylandDisplayUnset", "ldLibraryPathUnset", "runtimeRootUnset" ],
      "properties": {
        "displayUnset": { "const": true },
        "waylandDisplayUnset": { "const": true },
        "ldLibraryPathUnset": { "const": true },
        "runtimeRootUnset": { "const": true }
      }
    },
    "frameworks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "targetFramework", "total", "executed", "passed", "failed", "skipped", "timedOut", "failureClass", "durationMilliseconds" ],
        "properties": {
          "targetFramework": { "enum": [ "net8.0", "net10.0" ] },
          "total": { "const": 1 },
          "executed": { "const": 1 },
          "passed": { "const": 1 },
          "failed": { "const": 0 },
          "skipped": { "const": 0 },
          "timedOut": { "const": false },
          "failureClass": { "const": "clean" },
          "durationMilliseconds": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "videoio": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "backends", "cameraBackends", "missingFileOpen" ],
      "properties": {
        "backends": { "type": "string" },
        "cameraBackends": { "type": "string" },
        "missingFileOpen": { "const": "returned-false" }
      }
    },
    "verifiedCases": { "type": "array", "const": [ "HighGui NamedWindow deterministic missing-entrypoint or NOT_LINKED path", "HighGui DestroyWindow deterministic missing-entrypoint or NOT_LINKED path", "HighGui ImShow deterministic missing-entrypoint or NOT_LINKED path", "HighGui CreateTrackbar deterministic missing-entrypoint or NOT_LINKED path", "HighGui current UI framework deterministic missing-entrypoint or NOT_LINKED path", "codec PNG encode remains usable after failed HighGui calls", "VideoIO missing-file open returns explicit false and disposes cleanly" ] },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
