{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceKind", "status", "openCvVersion", "packageVersion", "sourceBaseCommit", "worktreeChangesIncluded", "execution", "hosted", "publicationAllowed", "genericStablePromoted", "baselineEvidence", "originalDistroEvidence", "managedSbomEvidence", "dockerHost", "sourceInputs", "kitManifest", "toolchains", "consumers", "coverage"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceKind": { "const": "local-linux-5.1-module-package-consumers" },
    "status": { "const": "verified-local-three-distro-x64-preview" },
    "openCvVersion": { "const": "5.1.0" },
    "packageVersion": { "const": "5.1.0" },
    "sourceBaseCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "worktreeChangesIncluded": { "const": true },
    "execution": { "const": "local-docker" },
    "hosted": { "const": false },
    "publicationAllowed": { "const": false },
    "genericStablePromoted": { "const": false },
    "baselineEvidence": { "$ref": "#/$defs/reference" },
    "originalDistroEvidence": { "$ref": "#/$defs/reference" },
    "managedSbomEvidence": { "$ref": "#/$defs/reference" },
    "dockerHost": {
      "type": "object", "additionalProperties": false, "required": ["architecture", "platform", "serverVersion"],
      "properties": { "architecture": { "const": "x86_64" }, "platform": { "const": "linux" }, "serverVersion": { "type": "string", "minLength": 1 } }
    },
    "sourceInputs": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/file" } },
    "kitManifest": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "$ref": "#/$defs/file" } },
    "toolchains": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["targetFramework", "sdkVersion", "runtimeVersion", "archive", "archiveSha512", "officialUrl"],
        "properties": {
          "targetFramework": { "enum": ["net8.0", "net10.0"] }, "sdkVersion": { "type": "string" }, "runtimeVersion": { "type": "string" },
          "archive": { "type": "string" }, "archiveSha512": { "type": "string", "pattern": "^[a-f0-9]{128}$" }, "officialUrl": { "type": "string", "pattern": "^https://builds\\.dotnet\\.microsoft\\.com/" }
        }
      }
    },
    "consumers": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/consumer" } },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["consumerRids", "targetFrameworks", "profiles", "nativeRuns", "fullOnnxInferenceRuns", "miniDnnOmissionRuns", "mjpgAviWriteReadRuns", "freshPackageCaches", "newProducerBuildExecuted", "arm64Validated", "hostedValidated", "cameraOrNetworkValidated", "arbitraryDnnModelsValidated", "finalReleaseApproved"],
      "properties": {
        "consumerRids": { "const": ["ubuntu.22.04-x64", "debian.12-x64", "fedora.44-x64"] },
        "targetFrameworks": { "const": ["net8.0", "net10.0"] }, "profiles": { "const": ["full", "mini"] },
        "nativeRuns": { "const": 12 }, "fullOnnxInferenceRuns": { "const": 6 }, "miniDnnOmissionRuns": { "const": 6 },
        "mjpgAviWriteReadRuns": { "const": 12 }, "freshPackageCaches": { "const": 12 },
        "newProducerBuildExecuted": { "const": false }, "arm64Validated": { "const": false }, "hostedValidated": { "const": false },
        "cameraOrNetworkValidated": { "const": false }, "arbitraryDnnModelsValidated": { "const": false }, "finalReleaseApproved": { "const": false }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "blob": {
      "type": "object", "additionalProperties": false, "required": ["name", "text", "bytes", "sha256"],
      "properties": { "name": { "type": "string", "minLength": 1 }, "text": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/hash" } }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "image", "imageId", "platform", "nanoCpus", "memoryBytes", "mounts", "imageArchitecture", "imageOs"],
      "properties": {
        "id": { "$ref": "#/$defs/hash" }, "name": { "type": "string", "minLength": 1 }, "image": { "type": "string", "pattern": "@sha256:[a-f0-9]{64}$" },
        "imageId": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }, "platform": { "const": "linux" },
        "nanoCpus": { "const": 2000000000 }, "memoryBytes": { "const": 2147483648 }, "imageArchitecture": { "const": "amd64" }, "imageOs": { "const": "linux" },
        "mounts": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["type", "source", "destination", "writable"],
            "properties": { "type": { "enum": ["bind", "volume"] }, "source": { "type": "string", "minLength": 1 }, "destination": { "enum": ["/consumer", "/kit"] }, "writable": { "type": "boolean" } }
          }
        }
      }
    },
    "consumer": {
      "type": "object", "additionalProperties": false, "required": ["rid", "identity", "outputDirectory", "blobs", "runs"],
      "properties": {
        "rid": { "enum": ["ubuntu.22.04-x64", "debian.12-x64", "fedora.44-x64"] }, "identity": { "$ref": "#/$defs/identity" }, "outputDirectory": { "type": "string", "minLength": 1 },
        "blobs": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/blob" } },
        "runs": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["targetFramework", "profile", "blobs", "video"],
            "properties": {
              "targetFramework": { "enum": ["net8.0", "net10.0"] }, "profile": { "enum": ["full", "mini"] },
              "blobs": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/blob" } },
              "video": {
                "type": "object", "additionalProperties": false, "required": ["artifactPath", "bytes", "sha256"],
                "properties": { "artifactPath": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 13 }, "sha256": { "$ref": "#/$defs/hash" } }
              }
            }
          }
        }
      }
    }
  }
}
