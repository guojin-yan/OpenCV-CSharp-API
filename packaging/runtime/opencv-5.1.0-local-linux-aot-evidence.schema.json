{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local OpenCV 5.1 Linux x64 NativeAOT package execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceKind",
    "status",
    "openCvVersion",
    "packageVersion",
    "sourceBaseCommit",
    "worktreeChangesIncluded",
    "execution",
    "hosted",
    "publicationAllowed",
    "genericStablePromoted",
    "references",
    "sourceInputs",
    "producerKitManifest",
    "runtimeKitManifest",
    "producer",
    "consumers",
    "coverage"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceKind": {
      "const": "local-linux-5.1-nativeaot-package-consumers"
    },
    "status": {
      "const": "verified-local-three-distro-x64-preview"
    },
    "openCvVersion": {
      "const": "5.1.0"
    },
    "packageVersion": {
      "const": "5.1.0"
    },
    "sourceBaseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "worktreeChangesIncluded": {
      "const": true
    },
    "execution": {
      "const": "local-docker"
    },
    "hosted": {
      "const": false
    },
    "publicationAllowed": {
      "const": false
    },
    "genericStablePromoted": {
      "const": false
    },
    "references": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha"
          }
        }
      }
    },
    "sourceInputs": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "producerKitManifest": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "runtimeKitManifest": {
      "type": "array",
      "minItems": 76,
      "maxItems": 76,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "outputDirectory",
        "blobs",
        "profiles"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "outputDirectory": {
          "type": "string"
        },
        "blobs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/blob"
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "blobs"
            ],
            "properties": {
              "name": {
                "enum": [
                  "full",
                  "mini"
                ]
              },
              "blobs": {
                "type": "array",
                "minItems": 16,
                "maxItems": 16,
                "items": {
                  "$ref": "#/$defs/blob"
                }
              }
            }
          }
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rid",
          "identity",
          "outputDirectory",
          "blobs",
          "runs"
        ],
        "properties": {
          "rid": {
            "enum": [
              "ubuntu.22.04-x64",
              "debian.12-x64",
              "fedora.44-x64"
            ]
          },
          "identity": {
            "$ref": "#/$defs/identity"
          },
          "outputDirectory": {
            "type": "string"
          },
          "blobs": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/blob"
            }
          },
          "runs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile",
                "blobs",
                "video"
              ],
              "properties": {
                "profile": {
                  "enum": [
                    "full",
                    "mini"
                  ]
                },
                "blobs": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 5,
                  "items": {
                    "$ref": "#/$defs/blob"
                  }
                },
                "video": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "bytes",
                    "sha256"
                  ],
                  "properties": {
                    "bytes": {
                      "const": 6288
                    },
                    "sha256": {
                      "const": "35f06c4c8ddfd2f0ac4265353ba17449a576a28fb35c9bc342108950e0963449"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "const": {
        "consumerRids": [
          "ubuntu.22.04-x64",
          "debian.12-x64",
          "fedora.44-x64"
        ],
        "targetFramework": "net10.0",
        "runtimeIdentifier": "linux-x64",
        "runtimeFrameworkVersion": "10.0.15",
        "profiles": [
          "full",
          "mini"
        ],
        "nativeAotPublishes": 2,
        "nativeAotExecutions": 6,
        "fullOnnxInferenceExecutions": 6,
        "miniImporterOmissionExecutions": 3,
        "mjpgAviWriteReadExecutions": 6,
        "externalDotNetRequired": false,
        "arm64Validated": false,
        "hostedValidated": false,
        "packageWideAotCompatibilityClaimed": false,
        "cameraOrNetworkValidated": false,
        "arbitraryModelsValidated": false,
        "finalReleaseApproved": false
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "bytes",
        "sha256",
        "text"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "image",
        "imageId",
        "platform",
        "nanoCpus",
        "memoryBytes",
        "mounts",
        "imageArchitecture",
        "imageOs",
        "oomKilled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "image": {
          "type": "string",
          "pattern": "@sha256:[0-9a-f]{64}$"
        },
        "imageId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "platform": {
          "const": "linux"
        },
        "nanoCpus": {
          "const": 2000000000
        },
        "memoryBytes": {
          "enum": [
            2147483648,
            3221225472
          ]
        },
        "imageArchitecture": {
          "const": "amd64"
        },
        "imageOs": {
          "const": "linux"
        },
        "oomKilled": {
          "const": false
        },
        "mounts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "source",
              "destination",
              "writable"
            ],
            "properties": {
              "type": {
                "enum": [
                  "bind",
                  "volume"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "destination": {
                "enum": [
                  "/kit",
                  "/producer",
                  "/consumer"
                ]
              },
              "writable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
