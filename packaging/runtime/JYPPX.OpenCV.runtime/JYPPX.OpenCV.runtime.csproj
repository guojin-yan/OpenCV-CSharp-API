<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimePackageRid Condition="'$(RuntimePackageRid)' == ''">win-x64</RuntimePackageRid>
    <RuntimePackageProfile Condition="'$(RuntimePackageProfile)' == ''">full</RuntimePackageProfile>
    <RuntimePackageProfileSuffix Condition="'$(RuntimePackageProfile)' != '' and '$(RuntimePackageProfile)' != 'full'">.$(RuntimePackageProfile)</RuntimePackageProfileSuffix>
    <PackageId>$(OpenCvCSharpRuntimePackageIdPrefix).$(RuntimePackageRid)$(RuntimePackageProfileSuffix)</PackageId>
    <Version>$(OpenCvCSharpPackageVersion)</Version>
    <PackageVersion>$(OpenCvCSharpPackageVersion)</PackageVersion>
    <Authors>guojin-yan</Authors>
    <Description>Native runtime package for OpenCV CSharp API ($(RuntimePackageRid), $(RuntimePackageProfile)).</Description>
    <PackageTags>opencv;runtime;native;$(RuntimePackageRid);$(RuntimePackageProfile)</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/guojin-yan/OpenCV-CSharp-API</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageIcon>logo.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../../nuget/logo.jpg" Pack="true" PackagePath="\" />
    <None Include="../runtime-distro-rid-graph.json" Pack="true" PackagePath="build" />
    <None Include="build/JYPPX.OpenCV.runtime.provenance.json" Condition="Exists('build/JYPPX.OpenCV.runtime.provenance.json')" Pack="true" PackagePath="build" />
    <None Include="buildTransitive/JYPPX.OpenCV.runtime.targets"
          Condition="'$(RuntimePackageRid)' == 'android-arm64' Or '$(RuntimePackageRid)' == 'android-arm' Or '$(RuntimePackageRid)' == 'android-x64' Or '$(RuntimePackageRid)' == 'android-x86'"
          Pack="true"
          PackagePath="buildTransitive/$(PackageId).targets" />
    <None Include="runtimes/$(RuntimePackageRid)/native/**/*" Pack="true" PackagePath="runtimes/$(RuntimePackageRid)/native" />
    <None Include="licenses/**/*" Pack="true" PackagePath="licenses" />
  </ItemGroup>
</Project>
