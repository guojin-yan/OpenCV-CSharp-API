{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/guojin-yan/OpenCV-CSharp-API/blob/opencv5.x/packaging/runtime/runtime-generic-linux-arm64-preview-matrix.schema.json",
  "title": "Generic linux-arm64 preview producer and consumer matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "status", "targetRid", "activePackageIdentityAllowed", "previewArtifactIdentityAllowed", "publicationAllowed", "activePackageMatrix", "designReference", "producer", "consumers", "rids", "profiles" ],
  "properties": {
    "$schema": { "const": "runtime-generic-linux-arm64-preview-matrix.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "preview-only" },
    "targetRid": { "const": "linux-arm64" },
    "activePackageIdentityAllowed": { "const": false },
    "previewArtifactIdentityAllowed": { "const": true },
    "publicationAllowed": { "const": false },
    "activePackageMatrix": { "const": "packaging/runtime/runtime-package-matrix.json" },
    "designReference": { "const": "docs/articles/generic-linux-rid-adr.md" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "rid", "sourceRid", "distro", "distroVersion", "runner", "execution", "containerImage", "profiles", "glibcBaseline", "artifactPrefix" ],
      "properties": {
        "rid": { "const": "linux-arm64" },
        "sourceRid": { "const": "ubuntu.22.04-arm64" },
        "distro": { "const": "ubuntu" },
        "distroVersion": { "const": "22.04" },
        "runner": { "const": "ubuntu-24.04-arm" },
        "execution": { "const": "container-on-native-aarch64" },
        "containerImage": { "type": "string", "pattern": "^ubuntu:22\\.04@sha256:[0-9a-f]{64}$" },
        "profiles": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": [ "full", "mini" ] } },
        "glibcBaseline": { "const": "2.35" },
        "artifactPrefix": { "const": "generic-linux-arm64-preview-runtime-input" }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "rid", "distro", "distroVersion", "runner", "role", "execution", "profiles" ],
        "properties": {
          "rid": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+-arm64$" },
          "distro": { "type": "string", "minLength": 1 },
          "distroVersion": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" },
          "runner": { "const": "ubuntu-24.04-arm" },
          "role": { "enum": [ "baseline", "forward-distro", "cross-distro" ] },
          "execution": { "enum": [ "hosted-native-aarch64", "container-on-native-aarch64" ] },
          "containerImage": { "type": "string", "pattern": "^[a-z0-9./:_-]+@sha256:[0-9a-f]{64}$" },
          "profiles": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": [ "full", "mini" ] } }
        }
      }
    },
    "rids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "rid", "platformFamily", "opencvRid", "nativeExtension", "producer" ],
        "properties": {
          "rid": { "const": "linux-arm64" },
          "platformFamily": { "const": "linux" },
          "opencvRid": { "const": "ubuntu.22.04-arm64" },
          "nativeExtension": { "const": ".so" },
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "kind", "profiles" ],
            "properties": {
              "kind": { "const": "container-on-native-aarch64" },
              "profiles": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": [ "full", "mini" ] } }
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [ "name", "packageIdSuffix", "buildList", "modules", "optionalModules", "packageId", "artifactName" ],
        "properties": {
          "name": { "enum": [ "full", "mini" ] },
          "packageIdSuffix": { "type": "string" },
          "buildList": { "type": "string", "minLength": 1 },
          "modules": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "optionalModules": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "packageId": { "type": "string", "pattern": "^JYPPX\\.OpenCV\\.runtime\\.linux-arm64\\.preview(?:\\.mini)?$" },
          "artifactName": { "type": "string", "pattern": "^nupkg-linux-arm64-preview-(?:full|mini)$" }
        }
      }
    }
  }
}
