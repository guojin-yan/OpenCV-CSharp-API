{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/OpenCV-CSharp-API/blob/opencv5.x/packaging/performance/perf-001-regression-baseline.schema.json",
  "title": "PERF-001 measured regression baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "status", "createdFromCommit", "runner", "workloads", "thresholds", "metrics", "limitations" ],
  "properties": {
    "$schema": { "const": "perf-001-regression-baseline.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "measured-baseline" },
    "createdFromCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": [ "os", "architecture", "dotnet", "configuration", "nativeRuntimePackage", "nativeRuntimePackageSha256", "nativePayload" ],
      "properties": {
        "os": { "type": "string", "minLength": 1 }, "architecture": { "const": "x64" },
        "dotnet": { "type": "string", "minLength": 1 }, "configuration": { "const": "Release" },
        "nativeRuntimePackage": { "type": "string", "minLength": 1 },
        "nativeRuntimePackageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "nativePayload": { "type": "array", "minItems": 18, "maxItems": 18, "items": { "type": "object", "additionalProperties": false, "required": [ "name", "bytes", "sha256" ], "properties": { "name": { "type": "string", "minLength": 1 }, "bytes": { "type": "integer", "minimum": 1 }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } }
      }
    },
    "workloads": { "type": "object", "additionalProperties": false, "required": [ "codecInputSha256", "typedMatInputSha256", "videoFileSha256", "dnnModelSha256", "iterations" ], "properties": { "codecInputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "typedMatInputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "videoFileSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "dnnModelSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "iterations": { "const": 100 } } },
    "thresholds": { "type": "object", "additionalProperties": false, "required": [ "elapsedTicksPercent", "managedAllocatedBytesPercent", "peakWorkingSetBytesPercent" ], "properties": { "elapsedTicksPercent": { "const": 20 }, "managedAllocatedBytesPercent": { "const": 10 }, "peakWorkingSetBytesPercent": { "const": 10 } } },
    "metrics": { "type": "object", "minProperties": 13, "additionalProperties": { "type": "object", "additionalProperties": false, "required": [ "managedAllocatedBytes", "elapsedTicks" ], "properties": { "managedAllocatedBytes": { "type": "integer", "minimum": 0 }, "elapsedTicks": { "type": "integer", "minimum": 0 }, "peakWorkingSetBytes": { "type": "integer", "minimum": 0 } } } },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
