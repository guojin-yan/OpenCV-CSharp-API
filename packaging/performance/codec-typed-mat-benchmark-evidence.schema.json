{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/OpenCV-CSharp-API/blob/opencv5.x/packaging/performance/codec-typed-mat-benchmark-evidence.schema.json",
  "title": "Codec and typed Mat benchmark evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "status", "runner", "codec", "typedMat", "limitations" ],
  "properties": {
    "$schema": { "const": "codec-typed-mat-benchmark-evidence.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "measured" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "os", "architecture", "dotnet", "configuration", "sourceCommit", "managedAssemblies", "nativeRuntimePackage", "nativeRuntimePackageSha256", "nativePayload" ],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "const": "x64" },
        "dotnet": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
        "configuration": { "const": "Release" },
        "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "managedAssemblies": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "targetFramework", "sha256" ],
            "properties": {
              "targetFramework": { "enum": [ "net8.0", "net10.0" ] },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        },
        "nativeRuntimePackage": { "type": "string", "minLength": 1 },
        "nativeRuntimePackageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "nativePayload": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [ "name", "bytes", "sha256" ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "bytes": { "type": "integer", "minimum": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "codec": {
      "type": "object",
      "required": [ "targetFramework", "iterations", "rows", "columns", "inputBytes", "inputSha256", "encodedBytes", "encodedSha256", "encodeByteArray", "encodeBufferWriter", "encodeBufferWriterReused", "decodeByteArray", "decodeSpanWithPreflight", "decodeStreamWithPreflight" ],
      "properties": {
        "targetFramework": { "const": "net8.0" },
        "iterations": { "const": 100 },
        "rows": { "const": 64 },
        "columns": { "const": 64 },
        "inputBytes": { "const": 12288 },
        "inputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "encodedBytes": { "type": "integer", "minimum": 1 },
        "encodedSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "encodeByteArray": { "$ref": "#/$defs/encodeMetric" },
        "encodeBufferWriter": { "$ref": "#/$defs/encodeMetric" },
        "encodeBufferWriterReused": { "$ref": "#/$defs/reusedEncodeMetric" },
        "decodeByteArray": { "$ref": "#/$defs/metric" },
        "decodeSpanWithPreflight": { "$ref": "#/$defs/metric" },
        "decodeStreamWithPreflight": { "$ref": "#/$defs/metric" }
      }
    },
    "typedMat": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [ "targetFramework", "iterations", "rows", "columns", "inputSha256", "rowAccessor", "matView", "readOnlyMatView" ],
        "properties": {
          "targetFramework": { "enum": [ "net8.0", "net10.0" ] },
          "iterations": { "const": 100 },
          "rows": { "const": 118 },
          "columns": { "const": 122 },
          "inputSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "rowAccessor": { "$ref": "#/$defs/metric" },
          "matView": { "$ref": "#/$defs/metric" },
          "readOnlyMatView": { "$ref": "#/$defs/metric" }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "$defs": {
    "encodeMetric": {
      "type": "object",
      "required": [ "managedAllocatedBytes", "elapsedTicks", "encodedBytes" ],
      "properties": {
        "managedAllocatedBytes": { "type": "integer", "minimum": 0 },
        "elapsedTicks": { "type": "integer", "minimum": 0 },
        "encodedBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "reusedEncodeMetric": {
      "type": "object",
      "required": [ "managedAllocatedBytes", "elapsedTicks", "encodedBytes", "getSpanCalls", "advanceCalls", "writerCapacity", "writerReused" ],
      "properties": {
        "managedAllocatedBytes": { "type": "integer", "minimum": 0 },
        "elapsedTicks": { "type": "integer", "minimum": 0 },
        "encodedBytes": { "type": "integer", "minimum": 0 },
        "getSpanCalls": { "type": "integer", "minimum": 0 },
        "advanceCalls": { "type": "integer", "minimum": 0 },
        "writerCapacity": { "type": "integer", "minimum": 1 },
        "writerReused": { "const": true }
      }
    },
    "metric": {
      "type": "object",
      "required": [ "managedAllocatedBytes", "elapsedTicks", "checksum" ],
      "properties": {
        "managedAllocatedBytes": { "type": "integer", "minimum": 0 },
        "elapsedTicks": { "type": "integer", "minimum": 0 },
        "checksum": { "type": "integer" },
        "decodedBytes": { "type": "integer", "minimum": 0 },
        "encodedBytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
