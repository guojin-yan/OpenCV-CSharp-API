{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/OpenCV-CSharp-API/blob/opencv5.x/packaging/codec/image-format-policy.schema.json",
  "title": "Managed image format and precision policy",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "status", "nativeDecodeClaim", "finalMatPrecisionClaim", "unknownFactPolicy", "formats", "limits", "forbiddenInferences" ],
  "properties": {
    "$schema": { "const": "image-format-policy.schema.json" },
    "schemaVersion": { "const": 1 },
    "status": { "const": "managed-preflight-policy" },
    "nativeDecodeClaim": { "const": "separate-runtime-dependent" },
    "finalMatPrecisionClaim": { "const": "unknown-until-decode" },
    "unknownFactPolicy": { "const": "preserve-unknown-unless-strict-option-rejects" },
    "formats": { "type": "array", "minItems": 15, "uniqueItems": true, "items": { "type": "object", "additionalProperties": false, "required": [ "name", "headerFacts", "frameFacts", "encodedPrecision", "finalMatPrecision" ], "properties": { "name": { "type": "string" }, "headerFacts": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string" } }, "frameFacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }, "encodedPrecision": { "type": "string" }, "finalMatPrecision": { "const": "unknown-until-decode" } } } },
    "limits": { "type": "array", "minItems": 10, "uniqueItems": true, "items": { "type": "string" } },
    "forbiddenInferences": { "type": "array", "minItems": 5, "uniqueItems": true, "items": { "type": "string" } }
  }
}
