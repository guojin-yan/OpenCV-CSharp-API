<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Company>JYPPX</Company>
    <Authors>guojin-yan</Authors>
    <Copyright>Copyright (c) 2026 guojin-yan</Copyright>
    <RepositoryUrl>https://github.com/guojin-yan/OpenCV-CSharp-API</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/guojin-yan/OpenCV-CSharp-API</PackageProjectUrl>
    <PackageTags>opencv;csharp;dotnet;computer-vision;image-processing</PackageTags>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
