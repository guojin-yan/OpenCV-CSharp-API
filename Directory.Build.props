<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <Company>JYPPX</Company>
    <Authors>guojin-yan</Authors>
    <Copyright>Copyright (c) 2026 guojin-yan</Copyright>
    <RepositoryUrl>https://github.com/guojin-yan/OpenCV-CSharp-API</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/guojin-yan/OpenCV-CSharp-API</PackageProjectUrl>
    <PackageTags>opencv;csharp;dotnet;computer-vision;image-processing</PackageTags>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Central version-neutral project metadata; fixed-major compatibility values are explicit exceptions. -->
    <OpenCvCSharpManagedPackageId>JYPPX.OpenCV.CSharp.API</OpenCvCSharpManagedPackageId>
    <OpenCvCSharpRuntimePackageIdPrefix>JYPPX.OpenCV.runtime</OpenCvCSharpRuntimePackageIdPrefix>
    <OpenCvCSharpRootNamespace>OpenCvSharp</OpenCvCSharpRootNamespace>
    <OpenCvCSharpOpenCvVersion>5.0.0</OpenCvCSharpOpenCvVersion>
    <OpenCvCSharpPackageRevision>0</OpenCvCSharpPackageRevision>
    <OpenCvCSharpPackageVersion>$(OpenCvCSharpOpenCvVersion).$(OpenCvCSharpPackageRevision)</OpenCvCSharpPackageVersion>
    <OpenCvCSharpCurrentNativeLibraryName>JYPPX.OpenCV.Native</OpenCvCSharpCurrentNativeLibraryName>
    <OpenCvCSharpCompatibilityNativeLibraryName>OpenCv5Sharp.Native</OpenCvCSharpCompatibilityNativeLibraryName>
  </PropertyGroup>
</Project>
