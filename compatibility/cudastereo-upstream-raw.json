      "kind": "callable",
      "name": "cv.cuda.createStereoSGM",
      "identity": "cv.cuda.createStereoSGM(int minDisparity=0;int numDisparities=128;int P1=10;int P2=120;int uniquenessRatio=5;int mode=cv::cuda::StereoSGM::MODE_HH4)->Ptr<cuda::StereoSGM>",
      "returnType": "Ptr<cuda::StereoSGM>",
