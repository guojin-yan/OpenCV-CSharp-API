      "name": "cv.cuda.CascadeClassifier.detectMultiScale",
      "identity": "cv.cuda.CascadeClassifier.detectMultiScale(Mat image;Mat objects[/O];Stream stream=Stream::Null()[/Ref])->void",
      "returnType": "void",
      "modifiers": [
        "/V",
        "/PV"
      ],
      "arguments": [
        {
          "type": "Mat",
          "name": "image",
          "default": "",
