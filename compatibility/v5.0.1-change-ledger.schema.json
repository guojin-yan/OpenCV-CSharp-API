{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/guojin-yan/OpenCV-CSharp-API/blob/opencv5.x/compatibility/v5.0.1-change-ledger.schema.json",
  "title": "OpenCV CSharp API v5.0.1 compatibility change ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [ "$schema", "schemaVersion", "fromVersion", "toVersion", "openCvVersion", "nativeAbiVersion", "policy", "entries" ],
  "properties": {
    "$schema": { "const": "v5.0.1-change-ledger.schema.json" },
    "schemaVersion": { "const": 1 },
    "fromVersion": { "const": "5.0.0" },
    "toVersion": { "const": "5.0.1" },
    "openCvVersion": { "const": "5.0.0" },
    "nativeAbiVersion": { "const": 1 },
    "policy": { "type": "string", "pattern": "additive-safe" },
    "entries": {
      "type": "array", "minItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [ "id", "category", "surface", "owner", "tfms", "profiles", "rollback", "evidence" ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "category": { "enum": [ "additive-safe", "tfm-conditional-preview", "internal-preview", "test-evidence", "documentation", "behavior-fix" ] },
          "surface": { "enum": [ "managed-api", "internal-managed", "tests", "consumer-tooling", "docs" ] },
          "owner": { "type": "string", "minLength": 2 },
          "tfms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "rollback": { "type": "string", "minLength": 10 },
          "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
