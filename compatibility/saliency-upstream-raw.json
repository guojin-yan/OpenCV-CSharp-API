      "ordinal": 3,
      "sourceHeader": "opencv-source/opencv_contrib-5.0.0/modules/saliency/include/opencv2/saliency/saliencyBaseClasses.hpp",
      "kind": "callable",
      "name": "cv.saliency.StaticSaliency.computeBinaryMap",
      "identity": "cv.saliency.StaticSaliency.computeBinaryMap(Mat _saliencyMap;Mat _binaryMap[/O])->bool",
      "returnType": "bool",
      "modifiers": [],
      "arguments": [
        {
          "type": "Mat",
