<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>LinuxAotConsumer</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <StripSymbols>true</StripSymbols>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>true</NuGetAudit>
    <WarningsAsErrors>NU1903;IL2026;IL3050</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JYPPX.OpenCV.CSharp.API" Version="5.1.0" />
    <PackageReference Include="__RUNTIME_PACKAGE__" Version="5.1.0" />
  </ItemGroup>
</Project>
