<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>false</ImplicitUsings>
  </PropertyGroup>
  <Import Project="..\..\SamplePackages.props" />
  <ItemGroup>
    <Compile Include="..\..\Common\SampleSupport.cs" Link="SampleSupport.cs" />
    <Compile Include="..\..\Common\ModelAssetSupport.cs" Link="ModelAssetSupport.cs" />
    <None Include="..\..\assets\models\model-assets.json"
          Link="Assets\model-assets.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CopyOpenCvNativeRuntime" AfterTargets="Build" Condition="'$(OpenCvNativeRuntimeDir)' != '' and '$(TargetDir)' != ''">
    <ItemGroup>
      <OpenCvNativeRuntimeFiles Include="$(OpenCvNativeRuntimeDir)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(OpenCvNativeRuntimeFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" />
  </Target>
</Project>
