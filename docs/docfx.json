{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/OpenCvSharp/OpenCvSharp.csproj"
          ],
          "src": ".."
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "articles/**.md",
          "api/**.yml",
          "api/index.md",
          "index.md",
          "toc.yml"
        ]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appName": "OpenCV CSharp API",
      "_appTitle": "OpenCV CSharp API",
      "_enableSearch": true
    }
  }
}
